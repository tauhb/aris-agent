{
  "name": "aris-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.12",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.11"
  },
  "scripts": {
    "build": "tsc -b packages/aris-hello packages/aris-ui-kit packages/aris-ui-sidebar packages/aris-ui-chat-header && node scripts/build-client.mjs && tsc -p packages/aris-ui-sidebar/tsconfig.client.json && tsc -p packages/aris-ui-chat-header/tsconfig.client.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:deps": "node scripts/check-deps.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm test && pnpm check:deps && pnpm check:licenses",
    "aris:setup": "node scripts/setup-profiles.mjs",
    "aris": "node scripts/dsh.mjs --profile aris web",
    "aris:acp": "node scripts/dsh.mjs --profile aris-acp",
    "aris:ask": "node scripts/dsh.mjs --profile aris-headless",
    "aris:config": "node scripts/dsh.mjs --profile aris --dump-config",
    "aris:spike": "node scripts/acp-handshake.mjs"
  }
}
