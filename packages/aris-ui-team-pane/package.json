{
  "name": "@aris/ui-team-pane",
  "version": "0.0.0",
  "private": true,
  "description": "Cột phải của aris: \"Đội bot lúc này\" (đội hình, việc gần đây) đứng đầu trang bắt đầu của cột phải dsh, giữ các lối mở Tệp, Terminal…",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@aris/ui-kit": "workspace:*"
  }
}
