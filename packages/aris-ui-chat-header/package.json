{
  "name": "@aris/ui-chat-header",
  "version": "0.0.0",
  "private": true,
  "description": "Đầu khung chat của aris: \"Bot / Phiên ▾\", danh sách phiên và nút phiên mới, cắm vào các slot đầu khung của dsh",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "dependencies": {
    "@aris/ui-kit": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2"
  }
}
