{
  "name": "@aris/ui-theme",
  "version": "0.0.0",
  "private": true,
  "description": "Theme aris cho toàn bộ Web UI của dsh: ghi đè token --dsw-* (màu, nền, viền, chữ, phông) cho cả sáng và tối",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "dependencies": {
    "@aris/ui-kit": "workspace:*"
  }
}
